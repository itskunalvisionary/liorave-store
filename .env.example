# ============================================================================
# TEMPLATE ONLY - keep every value EMPTY in this file.
# This file is read by the app at runtime and OVERRIDES hosting env vars,
# so real secrets must NEVER be written here. Set them in Render > Environment
# (production) or in a local .env file (development, git-ignored).
# ============================================================================

# 1. DATABASE (PostgreSQL - Neon)
SQL_HOST=
SQL_PORT=
SQL_SSL=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# 2. ADMIN STUDIO & SESSION SECURITY
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMAILS=

# 3. CLOUDINARY IMAGE UPLOADS
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# 4. GOOGLE SIGN-IN (optional)
VITE_ENABLE_GOOGLE_LOGIN=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_LOGIN_CODE=

# 5. GOOGLE SHEETS WEBHOOKS (optional)
GOOGLE_SHEET_URL=
GOOGLE_SHEET_DISPATCH_URL=
GOOGLE_SHEET_CONTACT_URL=
